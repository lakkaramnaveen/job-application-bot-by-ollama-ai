# Which LLM powers scoring/generation/answering: "claude" or "ollama"
LLM_PROVIDER=claude

# --- Claude provider ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# --- Ollama provider (free/local) ---
# Any model you've pulled: `ollama pull deepseek-r1:8b` / `llama3.1:8b` / `glm4:9b` / ...
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Only for a remote, authenticated model endpoint (a shared gateway, or Ollama
# behind a proxy): sent as "Authorization: Bearer <key>" on every request.
# Use an https:// OLLAMA_BASE_URL with it. Leave unset for local Ollama. Never
# commit a real key - .env stays out of git.
OLLAMA_API_KEY=
# Once `job-bot run` hits today's application cap, best-effort quit the
# local Ollama server/app so it stops holding the model in memory for the
# rest of the day. No effect with LLM_PROVIDER=claude, and no effect on a
# concurrent run/other process still using Ollama for something else - this
# is meant for the common single-user, single-purpose setup this project
# assumes. false (default) leaves Ollama running.
QUIT_OLLAMA_WHEN_DONE=false
# If Ollama isn't running when `job-bot run` starts, start it (the Ollama app
# on macOS, `ollama serve` elsewhere) instead of stopping with an error. Only
# for a local OLLAMA_BASE_URL. false (default) just reports it.
START_OLLAMA_IF_NEEDED=false

# --- Resume & profile ---
RESUME_PATH=./data/resume.pdf
FAQ_PATH=./data/faq_answers.json
BLACKLIST_PATH=./data/company_blacklist.json

# --- Safety rails ---
# Hard-capped in code at HARD_DAILY_APPLICATION_CEILING (currently 100,
# see config.py) regardless of what you set here - a backstop against a
# misconfigured or runaway run, not a normal day's operating limit.
DAILY_APPLICATION_CAP=20
REQUIRE_CONFIRM_BEFORE_SUBMIT=true
# Only cache an application-question answer to FAQ_PATH for reuse if the LLM's
# confidence is at least this high AND it's grounded in your resume/FAQ.
FAQ_SAVE_CONFIDENCE=0.7
# `job-bot report`'s default for how many days an application can sit in
# "applied" with no reply before it's flagged as worth a manual follow-up -
# overridable per-run with `job-bot report --stale-days`.
STALE_AFTER_DAYS=14

# At most this many applications, ever, to the same company - e.g. 1 so a run
# never sends several roles to one employer or recruiter. 0 = no limit.
MAX_APPLICATIONS_PER_COMPANY=0
# Count only applications in the last N days toward that limit (e.g. 14), so a
# company applied to weeks ago can get new applications. 0 = count all, ever.
COMPANY_LIMIT_WINDOW_DAYS=0
# Stop retrying a posting after its Easy Apply form fails this many times
# (each retry regenerates the resume and cover letter). 0 = retry forever.
MAX_APPLY_ATTEMPTS=3
# `job-bot run --loop`: minutes to pause after a cycle that applied to
# something before searching again (keeps LinkedIn from seeing one long
# burst of page loads). 0 = search again immediately.
MIN_CYCLE_GAP_MINUTES=5

# --- What `job-bot run` searches for (both optional; `--keywords` /
# `--location` override these for one run). SEARCH_KEYWORDS may list
# several titles, comma-separated - --loop searches one per cycle, in turn,
# so the request rate stays that of a single title ---
SEARCH_KEYWORDS=software engineer
SEARCH_LOCATION=United States
# true: only postings from the last 24 hours (default false: widen to the
# last 3 days when 24 hours doesn't fill the search pool).
SEARCH_LAST_24_HOURS_ONLY=false

# --- Role quality (all optional; also settable per-run via `job-bot run`'s
# --min-score / --exclude-title-keywords / --experience-level /
# --max-years-experience / --require-w2 flags, which override these for
# that one invocation) ---
# Extra floor on top of the model's own should_apply verdict - a posting is
# only applied to if should_apply is True AND its score clears this too.
# 0 (default) means no additional floor beyond the model's own judgment.
MIN_MATCH_SCORE=0
# Comma-separated, case-insensitive substrings - a posting whose title
# contains any of these is skipped before it's ever scored. Empty (default)
# means no filter. Example: forward deployed,sales engineer,av software
EXCLUDE_TITLE_KEYWORDS=
# Comma-separated LinkedIn seniority levels to restrict search results to:
# internship, entry, associate, mid-senior, director, executive. Empty
# (default) means every level. Note LinkedIn has no separate "mid" bucket -
# genuine mid-level postings are commonly tagged "mid-senior" alongside
# actual senior ones, so excluding that bucket entirely tends to filter out
# real mid-level roles too; MAX_YEARS_EXPERIENCE below is the finer-grained
# backstop for that. Example targeting entry-to-mid: entry,associate,mid-senior
DEFAULT_EXPERIENCE_LEVELS=
# A posting explicitly requiring more years of professional experience than
# this, or explicitly Senior/Staff/Principal/Lead/Director-or-higher, is
# skipped regardless of match score (see matching/scorer.py's eligibility
# check). Leave commented out (default) to disable this check - unlike the
# string settings above, an empty value here is invalid (not a number) and
# will fail to start, so remove the "#" and set a real number to enable it.
# MAX_YEARS_EXPERIENCE=6
# Skip postings explicitly stated as Corp-to-Corp (C2C), 1099, or otherwise
# not offered as direct W2 employment - a posting silent on employment type
# is not affected by this. false (default) disables the check.
REQUIRE_W2=false

# --- Applying on company websites (EXPERIMENTAL, off by default) ---
# Read README.md's "Applying on company websites (experimental)" section
# and job_bot/browser/external_apply_adapter.py's module docstring before
# turning this on. When true, `job-bot run` also applies to postings
# LinkedIn itself doesn't offer Easy Apply for, following their "Apply on
# company website" link and attempting a best-effort, heuristic fill on
# whatever form is actually there - unlike the LinkedIn flow, there is no
# single site's DOM this has been tuned against, so it will get real forms
# wrong sometimes. It will never solve a CAPTCHA, create an account, enter a
# password, or fill a field asking for an SSN/government ID/financial
# account number - it stops cleanly instead. Confirmation before submitting
# is always required on this path, regardless of REQUIRE_CONFIRM_BEFORE_SUBMIT.
ENABLE_EXTERNAL_APPLY=false

# --- Local storage ---
DB_PATH=./data/job_bot.sqlite3
BROWSER_PROFILE_DIR=./data/browser_profile
AUDIT_LOG_PATH=./data/audit.log
# A focused, append-only log of just the postings a run couldn't finish
# (scoring/tailoring failed, or the Easy Apply form couldn't be completed)
# and why. The same events land in AUDIT_LOG_PATH too, interleaved with
# every other action a run takes - this file is meant to be read on its own
# after a run to see what actually needs fixing.
FAILED_APPLICATIONS_LOG_PATH=./data/failed_applications.log
# Required questions Easy Apply couldn't confidently answer and left
# unanswered rather than guess - review and answer them with
# `job-bot review-answers`, which saves each answer to FAQ_PATH so every
# future posting that asks the same question gets it automatically. See
# README.md's "Learning from questions it couldn't answer" section.
ANSWER_GAPS_PATH=./data/answer_gaps.json
# Where tailored resumes/cover letters are written, as
# <APPLICATIONS_DIR>/<today's date>/<job id - company - title>/ - one folder
# per day's worth of applications. Point this outside the repo (e.g. a
# folder on your Desktop) if you want to browse it directly.
APPLICATIONS_DIR=./data/applications

# --- Browser profile (optional, most users leave this unset) ---
# Leave unset (default): job-bot launches its own isolated Chromium profile
# under BROWSER_PROFILE_DIR - you log into LinkedIn there once, and that
# profile never holds any other site's cookies (banking, email, ...).
# Set to attach to a Chrome you already run separately, permanently, with
# --remote-debugging-port for other tooling. This does NOT reuse your
# regular Chrome session - since Chrome 136, --remote-debugging-port is
# ignored on the default profile, so the debugged instance is necessarily a
# separate one anyway. See README.md's "Browser profile" section before
# enabling this - it's a real security tradeoff for that debugged profile.
# BROWSER_CDP_URL=http://localhost:9222

# --- Gmail sync (optional - see README.md's Gmail sync section for setup) ---
GMAIL_CREDENTIALS_PATH=./data/gmail_credentials.json
GMAIL_TOKEN_PATH=./data/gmail_token.json
GMAIL_SYNC_DAYS=14
GMAIL_MATCH_CONFIDENCE=0.6

# --- Dashboard ---
DASHBOARD_PORT=8765
